						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{client_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/client/invoices",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"client",
								"invoices"
							]
						}
					}
				}
			]
		},
		{
