{
	"info": {
		"_postman_id": "fossbilling-next-gen-api",
		"name": "FOSSBilling Next-Gen API",
		"description": "Koleksi API untuk simulasi backend FOSSBilling (Golang Edition)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Guest API (Public)",
			"item": [
				{
					"name": "Guest Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"client_token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"client@fossbilling.org\",\n    \"password\": \"client123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/guest/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"guest",
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "Check Domain Availability",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/guest/domains/check?domain=solusinusantara.id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"guest",
								"domains",
								"check"
							],
							"query": [
								{
									"key": "domain",
									"value": "solusinusantara.id"
								}
							]
						}
					}
				},
				{
					"name": "List Currencies",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/guest/currencies",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"guest",
								"currencies"
							]
						}
					}
				}
			]
		},
		{
